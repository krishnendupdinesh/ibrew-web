# =============================================================================
# Imaan's Store (iBrew) — Next.js Frontend Environment Template (Vercel)
# =============================================================================
# For Vercel deployment: Set these variables in the Vercel Project Settings -> Environment Variables.
# For Local development: Copy this file to ".env.local"
# Never commit real credentials or secrets to version control.

# URL of the Express + MySQL Backend on Render (without trailing slash)
# Production: https://your-backend.onrender.com
# Local: http://127.0.0.1:5001
BACKEND_URL=http://127.0.0.1:5001

# Security (Must match the JWT_SECRET configured in ibrew-backend)
JWT_SECRET=replace_with_a_strong_random_jwt_secret

# Administrator Configuration
ADMIN_NAME=ibrew Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ibrew.com
ADMIN_PASSWORD=replace_with_strong_admin_password
