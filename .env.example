# =============================================================================
# Imaan's Store (iBrew) — Next.js Frontend Environment Template
# Copy this file to ".env.local" (development) or set in your hosting platform.
# Never commit real credentials or secrets to version control.
# =============================================================================

# URL of the Node.js + Express + MySQL Backend API
BACKEND_URL=http://localhost:5001

# JWT & Admin Fallback Configuration (Must match ibrew-backend in production)
JWT_SECRET=replace_with_a_strong_random_jwt_secret
ADMIN_NAME=ibrew Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ibrew.com
ADMIN_PASSWORD=replace_with_strong_admin_password

